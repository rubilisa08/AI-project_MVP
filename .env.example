# Anthropic Claude API (필수) — https://console.anthropic.com 에서 발급
ANTHROPIC_API_KEY=

# 선택: 파이프라인에서 사용할 모델 (기본값: claude-sonnet-5)
CLAUDE_MODEL=claude-sonnet-5

# 선택: true로 설정하면 Claude API를 호출하지 않고 각 에이전트가 재무비율 임계값
# 기반의 목업 응답을 반환합니다. API 키 없이 UI/파이프라인 흐름만 확인할 때 사용하세요.
MOCK_LLM=false

# Supabase (필수 — 로그인 및 리포트 저장) — 프로젝트 Settings > API에서 확인
# anon/publishable key만 사용합니다. service_role 키는 이 앱에서 쓰지 않습니다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
